# EchaBot Environment Variables
# Copy this file to .env and fill in the values

# Groq API key (required for LLM features)
API_KEY=

# Optional: specify Groq model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Flask secret key (auto-generated if not set, but set one for persistent sessions)
# SECRET_KEY=your-random-secret-key-here
