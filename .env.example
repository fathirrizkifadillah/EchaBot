# EchaBot Environment Variables
# Copy this file to .env and fill in the values

# Groq API key (required for LLM features)
API_KEY=

# Optional: specify Groq model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Runtime environment: production rejects missing/short secrets
FLASK_ENV=development

# Flask/JWT secret key (minimum 32 characters in production)
SECRET_KEY=

# SQLAlchemy database URL; defaults to ./echabot.db
DATABASE_URL=sqlite:///echabot.db

# Google OAuth ID-token audience (optional until Google login is enabled)
GOOGLE_CLIENT_ID=

# Comma-separated frontend origins allowed by the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload and abuse protection
MAX_UPLOAD_MB=25
RATE_LIMIT_DEFAULT=120/minute
# Use redis://... for production and multi-worker deployments
RATELIMIT_STORAGE_URI=memory://
# Production defaults to 1; set 0 only for explicit local anonymous mode
REQUIRE_AUTH=0
SESSION_COOKIE_SECURE=0

# Frontend build/runtime
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_REQUIRE_AUTH=0

# Groq model/API key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
