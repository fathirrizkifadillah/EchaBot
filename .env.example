# EchaBot Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit real secret values to version control.

# Groq API key (required for LLM features)
GROQ_API_KEY=
API_KEY=

# Active Groq Models (Official active Meta Llama models)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Runtime environment: production rejects missing/short secrets
FLASK_ENV=development

# Flask/JWT secret key (minimum 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# SQLAlchemy database URL:
# 1. Local SQLite (defaults to ./echabot.db with automatic WAL mode enabled):
DATABASE_URL=sqlite:///echabot.db
# 2. Cloud PostgreSQL (Neon, Supabase, Render Postgres - auto-adds sslmode=require for remote hosts):
# DATABASE_URL=postgresql://user:password@ep-cool-sample.neon.tech/neondb
# DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres

# Persistent file storage location for uploaded datasets & reports
# On Render: Free web service disk is ephemeral! To persist datasets across redeploys,
# attach a Render Persistent Disk (e.g. mounted at /var/data/uploads) or point to object storage.
UPLOADS_DIR=./uploads

# Google OAuth ID-token audience (optional until Google login is enabled)
GOOGLE_CLIENT_ID=

# Comma-separated frontend origins allowed by the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting & Abuse Protection
MAX_UPLOAD_MB=25
RATE_LIMIT_DEFAULT=60/minute

# Rate Limiter Storage:
# - memory:// (default): In-process storage. NOTE: Each Gunicorn worker maintains its own
#   counter! With W workers, the cluster-wide effective limit is (configured_limit * W).
#   Safe for single-service / small deployments, but configure redis:// for strict cross-worker rate limiting.
# - redis://: Shared storage across all workers and replicas (e.g. redis://red-xxxx:6379)
RATELIMIT_STORAGE_URI=memory://

# Security & Cookies
# Production defaults to 1; set 0 only for explicit local anonymous mode
REQUIRE_AUTH=0
SESSION_COOKIE_SECURE=0

# Frontend build/runtime
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_REQUIRE_AUTH=0
